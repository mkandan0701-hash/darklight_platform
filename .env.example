# --- Database (Supabase Postgres) ---
# DATABASE_URL: pooled connection (port 6543, pgbouncer) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used by Prisma Migrate to run DDL.
DATABASE_URL="postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres"

# --- Auth (Supabase Auth, used as a standalone identity/JWT provider) ---
# NEXT_PUBLIC_* copies are read by the browser client in apps/web.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Verifies JWTs issued by Supabase Auth on both apps/web and apps/api
SUPABASE_JWT_SECRET=""

# --- Redis / BullMQ (Railway) ---
REDIS_URL="redis://localhost:6379"

# --- Stripe (USD, parent-facing) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Razorpay (INR settlement/backup) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Resend (email) ---
RESEND_API_KEY=""

# --- WhatsApp Business API (Meta Cloud API or BSP) ---
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- Claude API (Batch, monthly parent reports) ---
ANTHROPIC_API_KEY=""

# --- Cloudflare R2 (certificates, static assets) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="chessplay-clone-assets"

# --- Subdomain routing ---
# Production root domain (no protocol, no trailing slash, no leading "www.").
# Used by apps/web/middleware.ts to detect tenant subdomains vs the apex site.
# *.localhost works in local dev without setting this.
NEXT_PUBLIC_ROOT_DOMAIN="chessplayclone.com"

# --- Ports (local dev) ---
WEB_PORT=3000
API_PORT=4000
# Browser-facing URL of apps/api, used by the Socket.io client in apps/web.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Live session audio (WebRTC) ---
# Comma-separated STUN URLs. Defaults to Google's public STUN when unset.
# STUN alone can't traverse symmetric NAT or restrictive corporate firewalls —
# a TURN relay is the fix and is not yet configured. See apps/web/lib/audio/iceServers.ts.
NEXT_PUBLIC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
