{
  "name": "@chessplay-clone/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "worker": "tsx watch --env-file=.env src/worker.ts",
    "import:puzzles": "tsx --env-file=.env src/scripts/enqueuePuzzleImport.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@chessplay-clone/db": "*",
    "@chessplay-clone/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.12.11",
    "chess.js": "^1.0.0-beta.8",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fzstd": "^0.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "stripe": "^16.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
