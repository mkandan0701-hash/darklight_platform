// Prisma schema for the diaspora chess academy SaaS.
// Full model reference/rationale lives in chessplay-clone-spec.md at the repo root.
// Auth: Supabase Auth is used as a standalone identity/JWT provider (see .env.example
// SUPABASE_* vars). `User.authProviderId` stores the Supabase `auth.users.id` (uuid);
// a Supabase Auth webhook creates the matching `User` row here on signup.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Tenant {
  id         String    @id @default(cuid())
  name       String
  subdomain  String    @unique
  logoUrl    String?
  brandColor String?
  timezone   String
  planTier   PlanTier  @default(STARTER)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  users       User[]
  classrooms  Classroom[]
  tournaments Tournament[]
  invoices    Invoice[]
  puzzles     Puzzle[]
  classroomScheduleSlots ClassroomScheduleSlot[]
  pgnFolders  PgnFolder[]
  pgnFiles    PgnFile[]

  @@index([subdomain])
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String
  /// What people are called in the UI. Nullable because it can't be
  /// backfilled: nothing collected a name before this column existed, and
  /// inventing one from an email address is what `displayName()` already does
  /// as a fallback. Every render goes through that helper, so a null here is
  /// a display decision, not a missing value.
  displayName    String?
  role           Role
  timezone       String
  authProviderId String    @unique
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  coachProfile   CoachProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  createdInvoices Invoice[]
  recordedRatings RatingRecord[]
  issuedCertificates Certificate[]
  createdPgnFolders  PgnFolder[] @relation("PgnFoldersCreated")
  uploadedPgnFiles   PgnFile[]   @relation("PgnFilesUploaded")

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  ACADEMY_ADMIN
  COACH
  STUDENT
  PARENT
}

model CoachProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  tenantId String
  fideId   String?
  uscfId   String?
  eclId    String?
  bio      String?

  classrooms      ClassroomCoach[]
  referenceBoards ReferenceBoard[]

  @@index([tenantId])
}

model StudentProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  tenantId       String
  dateOfBirth    DateTime?
  fideId         String?
  uscfId         String?
  eclId          String?
  lichessHandle  String?
  chesscomHandle String?

  classrooms     ClassroomStudent[]
  parents        ParentStudent[]
  puzzleAttempts PuzzleAttempt[]
  games          Game[]
  attendance     AttendanceRecord[]
  invoices       Invoice[]
  ratingRecords  RatingRecord[]
  certificates   Certificate[]
  xpEvents       XpEvent[]
  badges         StudentBadge[]

  @@index([tenantId])
}

model ParentProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  tenantId String
  phone    String?

  children ParentStudent[]

  @@index([tenantId])
}

model ParentStudent {
  id        String         @id @default(cuid())
  tenantId  String
  parentId  String
  studentId String
  parent    ParentProfile  @relation(fields: [parentId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [id])
  // Unlinking a parent used to be the one hard DELETE in the application
  // (claude.md §4 forbids it — coaches and parents need an audit trail of who
  // had access to a child's record and when). The unique constraint below
  // still covers deleted rows, so re-linking revives the row rather than
  // inserting a second one; see linkParentToStudent.
  deletedAt DateTime?

  @@unique([parentId, studentId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Classrooms, sessions, homework
// ---------------------------------------------------------------------------

model Classroom {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  weekendFirst Boolean   @default(true)
  // A standing video link for the room (Google Meet, Zoom, Teams). Pasted,
  // not provisioned: a Meet link never expires, so one per classroom covers
  // every weekly occurrence without an OAuth integration. Live board + audio
  // remain the native path; this sits beside them, not instead of them.
  meetingUrl   String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  coaches      ClassroomCoach[]
  students     ClassroomStudent[]
  liveSessions LiveSession[]
  assignments  Assignment[]
  scheduleSlots ClassroomScheduleSlot[]

  @@index([tenantId])
}

// A recurring weekly time slot for a classroom (e.g. "Saturdays 10:00
// Asia/Kolkata, 60 min"). Stored in local terms (weekday + HH:mm + IANA zone)
// rather than a single UTC instant, because a fixed UTC offset silently
// drifts by an hour whenever the slot's own zone crosses a DST boundary —
// each occurrence is converted to UTC individually at generation time
// (packages/shared/src/scheduleSlots.ts), the same way zonedLocalToUtc
// already handles one-off session scheduling.
model ClassroomScheduleSlot {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  dayOfWeek    Int // luxon convention: 1=Mon..7=Sun
  localTime    String // "HH:mm", interpreted in `timezone`
  timezone     String
  durationMins Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  liveSessions LiveSession[]

  @@index([tenantId])
  @@index([classroomId])
}

model ClassroomCoach {
  id          String       @id @default(cuid())
  tenantId    String
  classroomId String
  coachId     String
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  coach       CoachProfile @relation(fields: [coachId], references: [id])

  @@unique([classroomId, coachId])
  @@index([tenantId])
}

model ClassroomStudent {
  id          String         @id @default(cuid())
  tenantId    String
  classroomId String
  studentId   String
  classroom   Classroom      @relation(fields: [classroomId], references: [id])
  student     StudentProfile @relation(fields: [studentId], references: [id])
  enrolledAt  DateTime       @default(now())

  @@unique([classroomId, studentId])
  @@index([tenantId])
}

model LiveSession {
  id             String        @id @default(cuid())
  tenantId       String
  classroomId    String
  classroom      Classroom     @relation(fields: [classroomId], references: [id])
  scheduledAtUtc DateTime
  durationMins   Int
  socketRoomId   String        @unique
  status         SessionStatus @default(SCHEDULED)

  // When the coach pressed Start. A recorded fact, not a status: nothing has
  // to come back later and flip it, so it can't go stale the way the old
  // status column did (see apps/web/lib/liveSession.ts). Its absence after a
  // session's end is what makes the session "delayed".
  startedAtUtc   DateTime?
  // Overrides Classroom.meetingUrl for this one occurrence.
  meetingUrl     String?
  updatedAt      DateTime      @default(now()) @updatedAt

  // Both null for a manually-scheduled one-off session (the only path before
  // weekend-first templates existed). Set together when a session is
  // auto-generated from a ClassroomScheduleSlot. occurrenceDate is the
  // idempotency key for materialization — the calendar date this occurrence
  // is *for*, in the slot's own timezone, not scheduledAtUtc's date (which
  // can differ by a day near midnight in that zone).
  scheduleSlotId String?
  scheduleSlot   ClassroomScheduleSlot? @relation(fields: [scheduleSlotId], references: [id])
  occurrenceDate String?

  referenceBoard ReferenceBoard?
  attendance     AttendanceRecord[]

  @@index([tenantId])
  // Postgres treats NULLs as distinct, so manually-scheduled rows (both
  // fields null) never collide with each other or with template rows.
  @@unique([scheduleSlotId, occurrenceDate])
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model ReferenceBoard {
  id            String       @id @default(cuid())
  tenantId      String
  liveSessionId String       @unique
  liveSession   LiveSession  @relation(fields: [liveSessionId], references: [id])
  coachId       String
  coach         CoachProfile @relation(fields: [coachId], references: [id])
  fen           String

  @@index([tenantId])
}

model AttendanceRecord {
  id            String         @id @default(cuid())
  tenantId      String
  liveSessionId String
  studentId     String
  liveSession   LiveSession    @relation(fields: [liveSessionId], references: [id])
  student       StudentProfile @relation(fields: [studentId], references: [id])
  mode          AttendanceMode
  present       Boolean
  markedAtUtc   DateTime       @default(now())

  @@unique([liveSessionId, studentId])
  @@index([tenantId])
}

enum AttendanceMode {
  ONLINE
  OFFLINE
}

model Assignment {
  id          String    @id @default(cuid())
  tenantId    String
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  title       String
  dueAtUtc    DateTime?
  createdAt   DateTime  @default(now())

  puzzles        AssignmentPuzzle[]
  puzzleAttempts PuzzleAttempt[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Puzzles, games, analysis
// ---------------------------------------------------------------------------

model Puzzle {
  id        String       @id @default(cuid())
  // LICHESS puzzles are global (tenantId null) — bulk-imported from the CC0
  // export, shared across every academy. UPLOAD puzzles are a coach's own
  // curated set, private to their tenant. Puzzle is intentionally exempt
  // from the automatic tenant-scoping guard (see packages/db/src/index.ts)
  // because of this global/private split — repositories are responsible for
  // filtering correctly (see apps/web/repositories/puzzleRepository.ts).
  tenantId  String?
  tenant    Tenant?      @relation(fields: [tenantId], references: [id])
  source    PuzzleSource @default(LICHESS)
  lichessId String?      @unique
  fen       String
  moves     String
  rating    Int?
  themes    String[]
  // Set only for source = UPLOAD. Plain scalar (no relation) — provenance
  // only, doesn't need to support querying puzzles from the User side.
  uploadedByUserId String?
  createdAt DateTime     @default(now())

  assignments AssignmentPuzzle[]
  attempts    PuzzleAttempt[]

  @@index([tenantId])
}

enum PuzzleSource {
  LICHESS
  UPLOAD
}

model AssignmentPuzzle {
  id           String     @id @default(cuid())
  tenantId     String
  assignmentId String
  puzzleId     String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  puzzle       Puzzle     @relation(fields: [puzzleId], references: [id])

  @@unique([assignmentId, puzzleId])
  @@index([tenantId])
}

model PuzzleAttempt {
  id             String         @id @default(cuid())
  tenantId       String
  studentId      String
  puzzleId       String
  assignmentId   String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  puzzle         Puzzle         @relation(fields: [puzzleId], references: [id])
  assignment     Assignment     @relation(fields: [assignmentId], references: [id])
  attemptMoves   Json
  isCorrect      Boolean
  timeTakenSecs  Int
  attemptedAtUtc DateTime       @default(now())

  @@index([tenantId])
  @@index([studentId, puzzleId])
  @@index([assignmentId, studentId])
}

model Game {
  id          String         @id @default(cuid())
  tenantId    String
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  source      GameSource
  externalId  String?
  pgn         String
  playedAtUtc DateTime
  result      String

  analysis GameAnalysis?

  @@unique([source, externalId])
  @@index([tenantId])
}

enum GameSource {
  PLATFORM
  LICHESS
  CHESSCOM
}

model GameAnalysis {
  id             String         @id @default(cuid())
  tenantId       String
  gameId         String         @unique
  game           Game           @relation(fields: [gameId], references: [id])
  engineDepth    Int
  accuracy       Float?
  blunders       Json
  completedAtUtc DateTime?
  status         AnalysisStatus @default(QUEUED)

  @@index([tenantId])
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  studentId       String
  student         StudentProfile  @relation(fields: [studentId], references: [id])
  amount          Int
  currency        String
  provider        PaymentProvider
  providerRef     String
  fxRateApplied   Float?
  status          InvoiceStatus   @default(PENDING)
  dueAtUtc        DateTime
  paidAtUtc       DateTime?
  // "October tuition" — every list/detail view needs this to be usable for a
  // parent reconciling multiple invoices.
  description     String?
  // Audit trail per CLAUDE.md §4 ("coaches and parents need audit trails").
  // Nullable so it never blocks a write if omitted.
  createdByUserId String?
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])

  @@unique([provider, providerRef])
  @@index([tenantId])
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Wave 4: tournaments, simul, gamification, certificates
// ---------------------------------------------------------------------------

model Tournament {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  name         String
  format       TournamentFormat
  socketRoomId String           @unique
  startsAtUtc  DateTime

  participants TournamentParticipant[]
  pairings     TournamentPairing[]

  @@index([tenantId])
}

enum TournamentFormat {
  SWISS
  ARENA
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tenantId     String
  tournamentId String
  studentId    String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  score        Float      @default(0)

  @@unique([tournamentId, studentId])
  @@index([tenantId])
}

model TournamentPairing {
  id           String     @id @default(cuid())
  tenantId     String
  tournamentId String
  round        Int
  whiteId      String
  blackId      String?
  result       String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  @@index([tenantId])
}

model Simul {
  id          String   @id @default(cuid())
  tenantId    String
  coachId     String
  startsAtUtc DateTime

  boards SimulBoard[]

  @@index([tenantId])
}

model SimulBoard {
  id           String @id @default(cuid())
  tenantId     String
  simulId      String
  boardIdx     Int
  studentId    String
  socketRoomId String @unique
  simul        Simul  @relation(fields: [simulId], references: [id])

  @@unique([simulId, boardIdx])
  @@index([tenantId])
}

model RatingRecord {
  id            String         @id @default(cuid())
  tenantId      String
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  federation    Federation
  rating        Int
  recordedAtUtc DateTime       @default(now())
  // Who entered this. Manual entry by a coach/admin is the ingestion
  // mechanism — FIDE/USCF/ECF have no consistent public API worth depending
  // on, so a scraper would be a fragile dependency for a wedge feature.
  // Nullable so it never blocks a write, same as Invoice.createdByUserId.
  recordedByUserId String?
  recordedBy       User?       @relation(fields: [recordedByUserId], references: [id])

  @@index([tenantId])
  @@index([studentId, federation])
}

enum Federation {
  FIDE
  USCF
  ECF
}

model Certificate {
  id          String          @id @default(cuid())
  tenantId    String
  studentId   String
  student     StudentProfile  @relation(fields: [studentId], references: [id])
  type        CertificateType
  pdfUrl      String
  issuedAtUtc DateTime        @default(now())
  // TOURNAMENT_RESULT is coach-typed free text: Tournament rows don't exist
  // yet (Wave 4, unbuilt), so there is nothing to derive this from. Persisted
  // rather than only rendered into the PDF, or the row could never be listed
  // or re-rendered without parsing the PDF back out. Null for the other two
  // types, whose content is derived at render time from attendance/ratings.
  eventName    String?
  eventResult  String?
  eventDateUtc DateTime?
  // Audit trail per claude.md §4, same shape as Invoice.createdByUserId.
  issuedByUserId String?
  issuedBy       User?        @relation(fields: [issuedByUserId], references: [id])

  @@index([tenantId])
}

enum CertificateType {
  ATTENDANCE
  RATING_MILESTONE
  TOURNAMENT_RESULT
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

// Demo requests from the public marketing site (apps/web/app/book-demo).
// Deliberately NOT tenant-scoped — and so intentionally absent from
// TENANT_SCOPED_MODELS in packages/db/src/tenantScope.ts — because the person
// booking is an anonymous prospect who has no Tenant yet. This is the same
// class of exception as `Tenant` and `Puzzle`, not an oversight.
model DemoBooking {
  id           String    @id @default(cuid())
  name         String
  email        String
  academyName  String?
  studentCount String?
  notes        String?
  // The chosen slot, stored in UTC per the timestamps-in-UTC rule in claude.md.
  slotAtUtc    DateTime
  // The IANA zone the visitor picked the slot in, so follow-up can quote the
  // time back to them in their own zone rather than the server's.
  timezone     String
  createdAt    DateTime  @default(now())
  contactedAt  DateTime?

  @@index([slotAtUtc])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Gamification (classroom-scoped)
// ---------------------------------------------------------------------------
// Deliberately not a public ladder: claude.md §9 rules out a chess.com-style
// rating ladder outside classrooms, so every leaderboard here is drawn inside
// one classroom, among people who already train together.

model XpEvent {
  id        String         @id @default(cuid())
  tenantId  String
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  kind      XpEventKind
  points    Int
  // The thing that earned it — a PuzzleAttempt id, an AttendanceRecord id.
  // Paired with kind in the unique below, this is what makes awarding
  // idempotent: re-running the same submission cannot pay out twice.
  sourceId     String
  awardedAtUtc DateTime @default(now())

  @@unique([studentId, kind, sourceId])
  @@index([tenantId])
  @@index([studentId])
}

enum XpEventKind {
  PUZZLE_SOLVED
  SESSION_ATTENDED
}

model StudentBadge {
  id        String         @id @default(cuid())
  tenantId  String
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  // A code from lib/gamification/badges.ts rather than an enum: badges are
  // product copy that will be added to often, and a new one should not need a
  // migration to hand out.
  code        String
  earnedAtUtc DateTime @default(now())

  @@unique([studentId, code])
  @@index([tenantId])
}

// --- PGN library -----------------------------------------------------------
// Folders and PGN files a coach keeps for teaching material: opening repertoires,
// annotated master games, a student's tournament games.
//
// File contents live in PgnFile.content rather than object storage. PGN is plain
// text measured in kilobytes, and keeping it on the row means it inherits the
// tenant scoping every other model has, so an unshared file is private by the
// same mechanism that protects an invoice. The alternative here was the R2
// bucket, which lib/storage/r2Client.ts documents as public-read because
// certificates need permanent public URLs — exactly the wrong property for
// coaching material. Downloads go through a route handler that re-checks
// access, so no storage URL is ever handed out.

model PgnFolder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  // Self-referential tree. A null parent is a root folder.
  parentId String?
  parent   PgnFolder?  @relation("PgnFolderTree", fields: [parentId], references: [id])
  children PgnFolder[] @relation("PgnFolderTree")

  /// Readable by students and parents in this academy. NOT public to the
  /// internet — there is no unauthenticated path to any of this. An unshared
  /// folder is staff-only, and that is enforced in the repository query rather
  /// than by hiding the card.
  isShared Boolean @default(false)

  /// Manual ordering within a parent. Reserved for drag-to-reorder; until then
  /// every row keeps its default and listing falls back to name.
  position Int @default(0)

  createdByUserId String?
  createdBy       User?    @relation("PgnFoldersCreated", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  files PgnFile[]

  // Stops two subfolders of the same parent sharing a name. Postgres treats
  // NULLs as distinct, so this does NOT constrain root folders — those are
  // checked in the repository, which has to run anyway to exclude soft-deleted
  // rows from the comparison.
  @@unique([tenantId, parentId, name])
  @@index([tenantId])
  @@index([parentId])
}

model PgnFile {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  folderId String
  folder   PgnFolder @relation(fields: [folderId], references: [id])
  name     String

  /// The uploaded text, byte for byte. Never re-serialized from a parse: a
  /// round trip through any parser drops comments, variations and nonstandard
  /// tags, and this is somebody's annotated work.
  content   String
  sizeBytes Int
  /// Games found by the parser. Nullable because a file whose structure could
  /// not be read is still stored rather than rejected.
  gameCount Int?

  position Int @default(0)

  uploadedByUserId String?
  uploadedBy       User?    @relation("PgnFilesUploaded", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@unique([tenantId, folderId, name])
  @@index([tenantId])
  @@index([folderId])
}
